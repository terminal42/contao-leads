{%- trans_default_domain 'contao_tl_lead' -%}

<!DOCTYPE html>
<html lang="{{ language }}">
<head>

    <meta charset="{{ charset }}">
    <title>{{ 'tl_lead.deleteAll.title'|trans }} | {{ host }}</title>
    <meta name="generator" content="Contao Open Source CMS">
    <meta name="viewport" content="width=device-width,initial-scale=1.0,shrink-to-fit=no">
    <meta name="referrer" content="origin">

    <link rel="stylesheet" href="{{ asset('confirm.css', 'system/themes/' ~ theme) }}">
    <link rel="stylesheet" href="{{ asset('leads.css', 'terminal42_leads') }}">
    {{ stylesheets|default|raw }}

    <script>{{ getLocaleString.invoke()|raw }}</script>
    <script src="{{ asset('js/mootools.min.js', 'contao-components/mootools') }}"></script>
    <script src="{{ asset('backend.js', 'contao_core') }}"></script>
    <script>{{ getDateString.invoke()|raw }}</script>
    {{ javascripts|default|raw }}

</head>
<body>

<div id="container">
    <main id="main">
        <form class="tl_form" method="post">
            <div class="tl_formbody_edit">
                <input type="hidden" name="FORM_SUBMIT" value="lead_delete_all">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                <h1>{{ 'tl_lead.deleteAll.title'|trans }}</h1>
                <table>
                    <tr>
                        <th scope="row">{{ 'tl_lead.deleteAll.formId'|trans }}:</th>
                        <td>{{ form.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'tl_lead.deleteAll.formTitle'|trans }}:</th>
                        <td>{{ form.title }}</td>
                    </tr>
                    <tr>
                        <th scope="row">{{ 'tl_lead.deleteAll.leadsCount'|trans }}:</th>
                        <td>{{ form.leadsCount }}</td>
                    </tr>
                </table>
                <p>{{ 'tl_lead.deleteAll.explain'|trans }}</p>
                <div class="submit_container cf">
                    <a href="{{ path('contao_backend', {do: 'lead', form: form.id}) }}" class="tl_submit" accesskey="c">{{ 'MSC.cancelBT'|trans([], 'contao_default') }}</a>
                    <button type="submit" name="delete" class="tl_submit delete-all-button" accesskey="d">{{ 'MSC.delete'|trans([], 'contao_default') }}</button>
                </div>
            </div>
        </form>
    </main>
</div>

</body>
</html>
